{
  "name": "@social/db",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "description": "PostgreSQL persistence layer (Prisma) for the Social Media Manager monorepo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "node ../../scripts/with-env.mjs prisma migrate deploy",
    "migrate:dev": "node ../../scripts/with-env.mjs prisma migrate dev",
    "grant:worker": "node ../../scripts/with-env.mjs prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20261001000000_social_worker_grants/migration.sql",
    "studio": "node ../../scripts/with-env.mjs prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.12"
  }
}
