# Copy to .env and adjust as needed.
# NEVER commit a real .env file or production credentials.

# --- Database (PostgreSQL via Prisma) ---------------------------------------
# Local dev value matches docker-compose.yml's `postgres` service.
DATABASE_URL="postgresql://social@localhost:5432/social"

# Least-privilege connection string for the scheduler worker (see
# packages/db/prisma/init/01-social-worker-role.sql and README.md
# "Least-privilege worker role"). Falls back to DATABASE_URL if unset.
# WORKER_DATABASE_URL="postgresql://social_worker:<password>@localhost:5432/social"
# docker compose only: the worker container cannot reach a localhost URL, so it
# defaults to social_worker on the compose network. Set this to override it with
# real credentials in production.
# WORKER_DATABASE_URL_CONTAINER="postgresql://social_worker:<password>@postgres:5432/social"

# Per-process connection pool size. The API and the scheduler worker each
# open their own pool, so size this for each process.
DATABASE_CONNECTION_LIMIT=5

# Production example — TLS required, and pooled through PgBouncer in
# transaction mode (note the required `pgbouncer=true` flag). Never commit
# the real value; set it via your hosting provider's secret manager.
# DATABASE_URL="postgresql://<user>:<password>@db.example.com:6432/social?sslmode=require&pgbouncer=true"

POSTGRES_USER=social
POSTGRES_DB=social
POSTGRES_PORT=5432

# --- App -------------------------------------------------------------------
# When true, all platform adapters run against local mocks — no OAuth apps
# or credentials for Instagram/Facebook/WhatsApp/LinkedIn/Substack/YouTube/
# Snapchat/TikTok/Strava are required for an end-to-end demo.
MOCK_MODE=true

# Exactly 64 hexadecimal characters (32 random bytes), used for AES-256-GCM
# encryption of stored OAuth tokens: openssl rand -hex 32
ENCRYPTION_KEY=

# The API's admin credential: at least 32 characters (openssl rand -hex 32).
# Required outside mock mode, where every API route except /health, /ready,
# sign-in and the OAuth callback needs it as `Authorization: Bearer <token>`.
# The dashboard asks for it once and trades it for a short-lived session, so
# the admin token itself is never stored in the browser.
ADMIN_TOKEN=
# How long a dashboard sign-in lasts, in hours (default 12).
# SESSION_TTL_HOURS=12

# The dashboard's public URL: where the browser lands after connecting an
# account.
BASE_URL=http://localhost:3000
# The API's public URL, used to build OAuth callback URLs (see the platform
# section below).
OAUTH_REDIRECT_BASE_URL=http://localhost:3001
# The API URL the dashboard calls. It is baked in when the dashboard is built,
# so rebuild after changing it.
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Browser origins allowed to call the API (comma-separated). The dashboard runs
# on a different port than the API, so it must be listed here. Mock mode
# defaults to http://localhost:3000; set this explicitly in production.
# WEB_ORIGIN=https://social.example.com

# Signs the OAuth `state` parameter (CSRF protection). Falls back to
# ADMIN_TOKEN, or in mock mode without one, to a random key per process.
# OAUTH_STATE_SECRET=

# Where the API listens. Defaults to every interface when ADMIN_TOKEN is set;
# an open mock-mode API (no ADMIN_TOKEN) listens on localhost only.
# API_HOST=0.0.0.0
# API_PORT=3001
# Behind a reverse proxy, trust its X-Forwarded-For so rate limits see client
# addresses: a hop count, true, or comma-separated proxy addresses/CIDRs.
# TRUST_PROXY=1
# Largest request body the API accepts, in bytes (default 1 MiB).
# API_BODY_LIMIT=1048576

# The MCP server (packages/mcp-server) is a client of this API. Its MCP host
# passes it SOCIAL_API_URL and SOCIAL_API_TOKEN (the ADMIN_TOKEN) — see
# README.md "MCP".

# --- Scheduler worker ------------------------------------------------------
# How often the worker polls for due posts, how many it claims per tick, and
# how long a claim lease lasts before another worker may take the post back
# (a worker that crashes mid-publish has its posts requeued after this).
WORKER_POLL_INTERVAL_MS=15000
WORKER_BATCH_SIZE=5
# Stable id in the worker's logs and in posts.claimed_by; defaults to a random
# one per process.
# WORKER_ID=

# Requests per minute per client IP: the whole API, and the tighter limits for
# the unauthenticated OAuth callback and dashboard sign-in attempts.
API_RATE_LIMIT=300
OAUTH_CALLBACK_RATE_LIMIT=20
SESSION_RATE_LIMIT=10

# Add each platform's OAuth client details and register the callback as
# OAUTH_REDIRECT_BASE_URL/api/oauth/<platform>/callback. Then connect the
# account from the dashboard's Setup page.
META_CLIENT_ID=
META_CLIENT_SECRET=
# Facebook posts to a Page feed and Instagram to the Page's linked Instagram
# Business account, so connecting resolves those ids rather than the /me user.
# Set these to pick a specific Page when the account administers several;
# otherwise the first Page returned is used.
FACEBOOK_PAGE_ID=
INSTAGRAM_PAGE_ID=
WHATSAPP_PHONE_NUMBER_ID=
# The WhatsApp Cloud API sends messages to opted-in recipients rather than
# broadcasting a post; publishing fans out to these numbers (comma separated),
# at most WHATSAPP_SEND_CONCURRENCY at a time (default 5).
WHATSAPP_RECIPIENTS=
WHATSAPP_SEND_CONCURRENCY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# private (default), unlisted, or public.
YOUTUBE_PRIVACY_STATUS=private
# Largest video the API downloads to upload to YouTube, in bytes (default 256 MiB).
# MEDIA_MAX_DOWNLOAD_BYTES=268435456
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unaudited TikTok apps may only post privately (SELF_ONLY).
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Snapchat and Substack expose no public API for publishing organic content,
# so they are intentionally not integrated; these values are unused.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Strava has no feed post; publishing creates an activity of this sport type.
STRAVA_SPORT_TYPE=Workout
