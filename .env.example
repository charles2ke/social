# Copy to .env and adjust as needed.
# NEVER commit a real .env file or production credentials.

# --- Database (PostgreSQL via Prisma) ---------------------------------------
# Local dev value matches docker-compose.yml's `postgres` service.
DATABASE_URL="postgresql://social@localhost:5432/social"

# Least-privilege connection string for the scheduler worker (see
# packages/db/prisma/init/01-social-worker-role.sql and README.md
# "Least-privilege worker role"). Falls back to DATABASE_URL if unset.
# WORKER_DATABASE_URL="postgresql://social_worker:<password>@localhost:5432/social"

# Per-process connection pool size. The web app and MCP server should each
# set this independently since they run as separate consumers.
DATABASE_CONNECTION_LIMIT=5

# Production example — TLS required, and pooled through PgBouncer in
# transaction mode (note the required `pgbouncer=true` flag). Never commit
# the real value; set it via your hosting provider's secret manager.
# DATABASE_URL="postgresql://<user>:<password>@db.example.com:6432/social?sslmode=require&pgbouncer=true"

POSTGRES_USER=social
POSTGRES_DB=social
POSTGRES_PORT=5432

# --- App -------------------------------------------------------------------
# When true, all platform adapters run against local mocks — no OAuth apps
# or credentials for Instagram/Facebook/WhatsApp/LinkedIn/Substack/YouTube/
# Snapchat/TikTok/Strava are required for an end-to-end demo.
MOCK_MODE=true

# Exactly 64 hexadecimal characters (32 random bytes), used for AES-256-GCM
# encryption of stored OAuth tokens: openssl rand -hex 32
ENCRYPTION_KEY=

# Generate a strong value before production use: openssl rand -hex 32
# Required outside mock mode: every API route except /health and the OAuth
# callback requires this value as a bearer token in the Authorization header.
ADMIN_TOKEN=
# Fallback single-account token used by the MCP server only; the API reads
# per-account tokens from the database instead.
SOCIAL_ACCESS_TOKEN=
BASE_URL=http://localhost:3000

# Signs the OAuth `state` parameter (CSRF protection). Falls back to
# ADMIN_TOKEN, then ENCRYPTION_KEY, when unset.
# OAUTH_STATE_SECRET=

# Requests per minute allowed against the unauthenticated OAuth callback.
OAUTH_CALLBACK_RATE_LIMIT=20

# Set only when the API is served from a different origin than the dashboard;
# it replaces BASE_URL when building OAuth redirect URIs.
# OAUTH_REDIRECT_BASE_URL=http://localhost:3001

# Add each platform's OAuth client details and register the callback as
# BASE_URL/api/oauth/<platform>/callback. Connect an account by visiting
# BASE_URL/api/oauth/<platform>/start.
META_CLIENT_ID=
META_CLIENT_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# The WhatsApp Cloud API sends messages to opted-in recipients rather than
# broadcasting a post; publishing fans out to these numbers (comma separated).
WHATSAPP_RECIPIENTS=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# private (default), unlisted, or public.
YOUTUBE_PRIVACY_STATUS=private
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unaudited TikTok apps may only post privately (SELF_ONLY).
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Snapchat and Substack expose no public API for publishing organic content,
# so they are intentionally not integrated; these values are unused.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Strava has no feed post; publishing creates an activity of this sport type.
STRAVA_SPORT_TYPE=Workout
