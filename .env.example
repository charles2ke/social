# Copy to .env and adjust as needed.
# NEVER commit a real .env file or production credentials.

# --- Database (PostgreSQL via Prisma) ---------------------------------------
# Local dev value matches docker-compose.yml's `postgres` service.
DATABASE_URL="postgresql://social:social@localhost:5432/social"

# Least-privilege connection string for the scheduler worker (see
# packages/db/prisma/init/01-social-worker-role.sql and README.md
# "Least-privilege worker role"). Falls back to DATABASE_URL if unset.
# WORKER_DATABASE_URL="postgresql://social_worker:<password>@localhost:5432/social"

# Per-process connection pool size. The web app and MCP server should each
# set this independently since they run as separate consumers.
DATABASE_CONNECTION_LIMIT=5

# Production example — TLS required, and pooled through PgBouncer in
# transaction mode (note the required `pgbouncer=true` flag). Never commit
# the real value; set it via your hosting provider's secret manager.
# DATABASE_URL="postgresql://<user>:<password>@db.example.com:6432/social?sslmode=require&pgbouncer=true"

POSTGRES_USER=social
POSTGRES_DB=social
POSTGRES_PORT=5432

# --- App -------------------------------------------------------------------
# When true, all platform adapters run against local mocks — no OAuth apps
# or credentials for Instagram/Facebook/WhatsApp/LinkedIn/Substack/YouTube/
# Snapchat/TikTok/Strava are required for an end-to-end demo.
MOCK_MODE=true

# 32-byte (base64) key used for AES-256-GCM encryption of stored OAuth
# tokens. Generate your own with: openssl rand -base64 32
# ENCRYPTION_KEY="replace-with-32-byte-base64-key"
