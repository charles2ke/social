{
  "name": "social",
  "private": true,
  "version": "0.0.0",
  "description": "Social Media Manager monorepo",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm --parallel --filter web --filter api dev",
    "db:generate": "pnpm --filter @social/db run generate",
    "db:migrate": "pnpm --filter @social/db run migrate",
    "db:studio": "pnpm --filter @social/db run studio"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "22.10.2",
    "eslint": "9.18.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "3.2.7"
  }
}
