{
  "name": "social",
  "private": true,
  "version": "0.0.0",
  "description": "Social Media Manager monorepo",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "e2e": "pnpm --filter @social/web run e2e",
    "dev": "pnpm --parallel --filter web --filter api dev",
    "db:generate": "pnpm --filter @social/db run generate",
    "db:migrate": "pnpm --filter @social/db run migrate",
    "db:studio": "pnpm --filter @social/db run studio"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.23"
    }
  }
}
